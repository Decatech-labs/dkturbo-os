{
  "name": "dkturbo-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/compose/compose.dev.yml up -d",
    "db:down": "docker compose -f infra/compose/compose.dev.yml down",
    "db:logs": "docker compose -f infra/compose/compose.dev.yml logs -f postgres",
    "db:ps": "docker compose -f infra/compose/compose.dev.yml ps",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:test": "DATABASE_URL=postgresql://dkturbo:dkturbo_test@127.0.0.1:5433/dkturbo_test pnpm db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
